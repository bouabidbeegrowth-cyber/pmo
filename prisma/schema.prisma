// PMO Mastery — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("ADMIN") // ADMIN | SUPER_ADMIN
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Event (supports multiple editions — PMO Mastery 2025, 2026, 2027, …)
// ---------------------------------------------------------------------------

model Event {
  id                  String   @id @default(cuid())
  slug                String   @unique
  editionName         String   // e.g. "PMO Mastery 2025"
  titleFr             String
  titleEn             String
  subtitleFr          String?
  subtitleEn          String?
  themeTaglineFr      String?
  themeTaglineEn      String?
  descriptionFr       String?
  descriptionEn       String?

  startDate           DateTime
  endDate             DateTime?
  startTime           String?  // "09:00"
  endTime             String?  // "18:00"
  timezone            String   @default("Africa/Tunis")
  countdownTarget     DateTime? // exact moment the countdown counts down to

  venue               String?
  address             String?
  city                String?
  country             String?
  latitude            Float?
  longitude           Float?
  mapUrl              String?

  heroImageDesktop    String?
  heroImageMobile     String?
  heroLogo            String?
  ogImage             String?

  registrationEnabled Boolean  @default(true)
  status              String   @default("UPCOMING") // UPCOMING | LIVE | ENDED
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  speakers            Speaker[]
  programmeDays       ProgrammeDay[]
  passes              Pass[]
  organizers          Organizer[]
  partners            Partner[]
  popups              Popup[]
  galleryItems        GalleryItem[]
  contactInfo         ContactInfo?
  websiteSections     WebsiteSection[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Gallery — photos + videos per event edition. Videos are external links
// (YouTube/Vimeo), never uploaded files, so there's no video storage/bandwidth
// cost. Public /galerie page lets visitors switch between editions.
// ---------------------------------------------------------------------------

model GalleryItem {
  id           String   @id @default(cuid())
  eventId      String
  type         String   // IMAGE | VIDEO
  imageUrl     String?  // IMAGE: uploaded photo
  videoUrl     String?  // VIDEO: external YouTube/Vimeo URL
  thumbnail    String?  // VIDEO: optional custom thumbnail (uploaded); falls back to provider thumbnail
  captionFr    String?
  captionEn    String?
  isActive     Boolean  @default(true)
  showOnHomepage Boolean @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ---------------------------------------------------------------------------
// UI text — admin-editable translation catalog for hardcoded page chrome
// (nav labels, headings, buttons, empty states) that isn't part of the
// richer WebsiteSection content model. Global, not Event-scoped.
// ---------------------------------------------------------------------------

model UiText {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  valueFr   String
  valueEn   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// SEO — per-page meta title/description/OG image, admin-editable. Global
// (not Event-scoped), fixed page-key catalog like UiText: admins edit
// values for a known, seeded set of pages, never create/delete keys.
// ---------------------------------------------------------------------------

model SeoMeta {
  id            String   @id @default(cuid())
  page          String   @unique // "home" | "evenement" | "programme" | ...
  titleFr       String?
  titleEn       String?
  descriptionFr String?
  descriptionEn String?
  ogImage       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// URL redirects — admin-managed, exact-path only (no wildcards). Enforced in
// src/proxy.ts on every public request.
// ---------------------------------------------------------------------------

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique // must start with "/", e.g. "/old-page"
  toPath    String   // relative path or absolute URL
  permanent Boolean  @default(true) // true -> 308, false -> 307
  isActive  Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// robots.txt settings — structured, not raw text: the baseline safety rules
// (disallow /admin, /api) are always hardcoded in src/app/robots.ts and
// can't be edited away by mistake. Admins can only add to that baseline.
// Singleton row (id is always "singleton").
// ---------------------------------------------------------------------------

model SeoSettings {
  id             String   @id @default("singleton")
  extraDisallow  String?  // newline-separated additional paths to disallow
  extraAllow     String?  // newline-separated additional paths to explicitly allow
  crawlDelay     Int?     // seconds, applied to User-agent: *
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sitemap — per-page include/priority override for the fixed set of known
// public pages, plus admin-added custom URLs (e.g. an external landing page).
// ---------------------------------------------------------------------------

model SitemapEntry {
  id               String   @id @default(cuid())
  page             String   @unique // matches a sitemap.ts page key
  included         Boolean  @default(true)
  priorityOverride Float?
  updatedAt        DateTime @updatedAt
}

model SitemapExtraUrl {
  id         String   @id @default(cuid())
  path       String   @unique // relative path or absolute URL
  priority   Float    @default(0.5)
  changeFreq String   @default("monthly")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Speakers / Intervenants
// ---------------------------------------------------------------------------

model Speaker {
  id            String   @id @default(cuid())
  eventId       String
  slug          String
  firstName     String
  lastName      String
  photo         String?
  positionFr    String?
  positionEn    String?
  company       String?
  biographyFr   String?
  biographyEn   String?
  country       String?
  linkedinUrl   String?
  websiteUrl    String?
  twitterUrl    String?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions      SessionSpeaker[]
  moderatedSessions ProgrammeSession[] @relation("SessionModerator")

  @@unique([eventId, slug])
  @@index([eventId, isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// Programme (Days → Sessions, with M2M speaker assignment)
// ---------------------------------------------------------------------------

model ProgrammeDay {
  id           String   @id @default(cuid())
  eventId      String
  nameFr       String
  nameEn       String?
  date         DateTime
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions     ProgrammeSession[]

  @@index([eventId, displayOrder])
}

model ProgrammeSession {
  id              String   @id @default(cuid())
  programmeDayId  String
  startTime       String   // "09:00"
  endTime         String?  // "10:15"
  titleFr         String
  titleEn         String?
  titleAr         String?
  descriptionFr   String?
  descriptionEn   String?
  sessionType     String   @default("SESSION") // KEYNOTE | PANEL | BREAK | NETWORKING | CLOSING | WORKSHOP | SESSION
  language        String?  // FR | EN | AR | MIXED
  room            String?
  topic           String?
  isHeader        Boolean  @default(false) // plain-text section divider (e.g. "Plenary Session 1: ...") — no time/speakers/CTA
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  programmeDay    ProgrammeDay @relation(fields: [programmeDayId], references: [id], onDelete: Cascade)
  speakers        SessionSpeaker[]
  moderator       Speaker?    @relation("SessionModerator", fields: [moderatorId], references: [id])
  moderatorId     String?

  @@index([programmeDayId, displayOrder])
}

model SessionSpeaker {
  sessionId  String
  speakerId  String

  session    ProgrammeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker    Speaker          @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
}

// ---------------------------------------------------------------------------
// Passes / Tickets (with payment URL management)
// ---------------------------------------------------------------------------

model Pass {
  id              String   @id @default(cuid())
  eventId         String
  slug            String
  nameFr          String
  nameEn          String?
  descriptionFr   String?
  descriptionEn   String?
  price           Float
  currency        String   @default("TND")
  vatRate         Float    @default(0.19)
  featuresFr      String?  // newline-separated list
  featuresEn      String?
  paymentUrl      String?  // external registration/payment URL
  minQuantity     Int      @default(1)
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
  @@index([eventId, isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// Organizers & Partners
// ---------------------------------------------------------------------------

model Organizer {
  id                  String   @id @default(cuid())
  eventId             String
  name                String
  logo                String?
  descriptionFr       String?
  descriptionEn       String?
  websiteUrl          String?
  linkedinUrl         String?
  facebookUrl         String?
  instagramUrl        String?
  founderName         String?
  founderTitle        String?
  founderPhoto        String?
  founderCredentials  String?
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, isActive, displayOrder])
}

model Partner {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  logo          String?
  category      String   @default("PARTNER") // STRATEGIC | DIAMOND | GOLD | SILVER | MEDIA | INSTITUTIONAL | PARTNER
  websiteUrl    String?
  descriptionFr String?
  descriptionEn String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// Popups — admin-managed social-proof / announcement bubbles that cycle on
// the public site (photo, name, short message, optional link).
// ---------------------------------------------------------------------------

model Popup {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  photo        String?
  messageFr    String
  messageEn    String?
  ctaUrl       String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, isActive, displayOrder])
}

// ---------------------------------------------------------------------------
// CMS — editable website sections (Hero, Why Participate, About, Footer)
// ---------------------------------------------------------------------------

model WebsiteSection {
  id              String   @id @default(cuid())
  eventId         String
  sectionKey      String   // HERO | WHY_PARTICIPATE | ABOUT | FOOTER
  titleFr         String?
  titleEn         String?
  subtitleFr      String?
  subtitleEn      String?
  descriptionFr   String?  // long text — supports \n
  descriptionEn   String?
  ctaTextFr       String?
  ctaTextEn       String?
  ctaUrl          String?
  backgroundImage String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  benefits        Benefit[]

  @@unique([eventId, sectionKey])
}

model Benefit {
  id                String   @id @default(cuid())
  websiteSectionId  String
  icon              String?  // lucide icon name e.g. "Sparkles"
  titleFr           String
  titleEn           String?
  descriptionFr     String?
  descriptionEn     String?
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)

  websiteSection    WebsiteSection @relation(fields: [websiteSectionId], references: [id], onDelete: Cascade)

  @@index([websiteSectionId, displayOrder])
}

// ---------------------------------------------------------------------------
// Contact information
// ---------------------------------------------------------------------------

model ContactInfo {
  id           String   @id @default(cuid())
  eventId      String
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  mapUrl       String?
  linkedinUrl  String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String?
  mimeType     String
  size         Int
  url          String
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Contact form submissions (so the public form has a real backend)
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
